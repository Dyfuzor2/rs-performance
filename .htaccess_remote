# === AVIF IMAGE SUPPORT ===

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/avif-sequence .avifs
    AddType text/markdown .md
    AddType text/yaml .yaml .yml
</IfModule>

<Files "changes.json">
<IfModule mod_headers.c>
Header set Content-Type "application/feed+json; charset=UTF-8"
</IfModule>
</Files>

<FilesMatch "^(openapi)\.(yaml|yml)$">
<IfModule mod_headers.c>
Header set Content-Type "text/yaml; charset=UTF-8"
</IfModule>
</FilesMatch>

<Files "sw.js">
<IfModule mod_headers.c>
Header set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0"
Header unset Expires
</IfModule>
</Files>

# AVIF content negotiation (serve AVIF when browser supports it)

<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_ACCEPT} image/avif
    RewriteCond %{REQUEST_URI} \.(jpe?g|png|webp)$
    RewriteCond %{DOCUMENT_ROOT}/img/avif/$1.avif -f
    RewriteRule ^img/(.+)\.(jpe?g|png|webp)$ img/avif/$1.avif [T=image/avif,L]
</IfModule>

# === GZIP COMPRESSION ===

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml application/xhtml+xml image/svg+xml font/woff2 font/woff
</IfModule>
# === BROTLI (if available) ===
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>

# === AI DISCOVERY FILES ===

# CORS + cache bypass for AI agents, crawlers, and LLM tools

<IfModule mod_headers.c>
    <FilesMatch "(llms\.txt|llms-full\.txt|mcp\.json|ai-plugin\.json|mcp-agent-card\.json|ai-resources\.json)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Cache-Control "public, max-age=3600, no-transform"
        Header always unset Vary
        Header always unset Retry-After
    </FilesMatch>
</IfModule>
# Exclude AI discovery files from LSCache (prevent Vary: User-Agent)
<IfModule LiteSpeed>
    <FilesMatch "(llms\.txt|llms-full\.txt|mcp\.json|ai-plugin\.json|mcp-agent-card\.json|ai-resources\.json)$">
        CacheLookup off
        CacheStore off
    </FilesMatch>
</IfModule>
# === BROWSER CACHE ===
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
        ExpiresByType image/avif "access plus 1 year"
        ExpiresByType image/avif-sequence "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
# === CACHE CONTROL HEADERS ===
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|ico|svg|woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable" env=!no_filament_asset_cache
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000" env=!no_filament_asset_cache
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2|woff)$">
        Header set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0" env=no_filament_asset_cache
        Header unset Expires env=no_filament_asset_cache
    </FilesMatch>
</IfModule>

<Files "sw.js">
<IfModule mod_headers.c>
Header set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0"
Header unset Expires
</IfModule>
</Files>

