# === LITESPEED CACHE ===

<IfModule LiteSpeed>
    CacheLookup on
    CacheEngine on
</IfModule>
# Exclude dynamic routes from LSCache
SetEnvIf Request_URI ^/$ no_lscache
SetEnvIf Request_URI ^/(admin|api|klient|flota|livewire|sanctum|pulse|sw\.js|manifest\.json|site\.webmanifest|offline\.html) no_lscache
# Long TTL for static content pages (24h)
SetEnvIf Request_URI "^/(uslugi|problemy|raporty-napraw|blog)/" long_cache
SetEnvIf Request_URI "^/(css|js|fonts)/filament/" no_filament_asset_cache
<IfModule mod_headers.c>
    # Default: 4 hours + stale-while-revalidate
    Header set X-LiteSpeed-Cache-Control "public, max-age=14400, stale-while-revalidate=3600" env=!no_lscache
    Header set X-LiteSpeed-Tag "app" env=!no_lscache
    # Service/problem/blog pages: 24 hours (content rarely changes)
    Header set X-LiteSpeed-Cache-Control "public, max-age=86400, stale-while-revalidate=7200" env=long_cache
    # Dynamic app surfaces must never be stored client-side or at the edge.
    Header always set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0" env=no_lscache
    Header always unset Expires env=no_lscache
    Header always unset X-LiteSpeed-Cache-Control env=no_lscache
    Header always unset X-LiteSpeed-Tag env=no_lscache
</IfModule>
# === END LITESPEED CACHE ===

# ModSecurity + fortress + edge headers MUST NOT live inside mod_rewrite (LiteSpeed/Apache parse order).
