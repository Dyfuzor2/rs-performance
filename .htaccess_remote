<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "all, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    Header always set X-AI-Training-Policy "permitted; license=CC-BY-SA-4.0; attribution=RS Performance"
    Header always set X-AI-Crawl-Depth "full-site; follow-sections; priority-pages=/uslugi,/problemy,/raporty-napraw,/blog,/kody-usterek"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://unpkg.com https://analytics.rs3d.pl; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://analytics.rs3d.pl https://mcp.rs3d.pl; frame-src 'self' https://www.google.com https://maps.google.com;"
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=14400, stale-while-revalidate=3600" env=!no_lscache
        Header set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0" env=no_lscache
        Header unset X-LiteSpeed-Cache-Control env=no_lscache
        Header unset X-LiteSpeed-Tag env=no_lscache
    </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
    RewriteEngine On
    # SEO: Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # SEO: Redirect WWW to non-WWW
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    # === RS WAF EDGE SHIELD (Apr 2026) — sync with config/waf.php edge_uri_fragments ===
    # Drops credential-phishing probes & script-kiddie paths before PHP.403 = hard edge.
    RewriteCond %{REQUEST_URI} (?i)(wp-login\.php|wp-admin|wp-content/|wp-includes/|xmlrpc\.php|phpmyadmin|/pma/|pma\.php|adminer\.php|adminer/|vendor/phpunit|/\.git/|/\.svn/|cgi-bin/|boaform|shell\.php|c99\.php|r57\.php|thinkphp|laravel/\.env|/\.env|actuator/|server-status|telescope/|_profiler/|phpinfo\.php|info\.php|alfacgiapi) [OR]
    RewriteCond %{QUERY_STRING} (?i)(union.*select|sleep\s*\(|benchmark\s*\(|into\s+(outfile|dumpfile)|%00%00|<script|javascript:|onerror=|onload=|eval\s*\(|base64_decode\s*\(|0x[0-9a-f]{32,}|169\.254\.169\.254|metadata\.google|127\.0\.0\.1:\d+) [OR]
    RewriteCond %{QUERY_STRING} (?i)(\.\./\.\./etc/passwd)
    RewriteRule .* - [F,L]
    # Do not hard-block non-dangerous bots on canonical.
    # Policy March 2026+: observe, attribute and route where useful instead of denying by default.
    # WOW AEO Gateway Routing Strategy (Upgraded 2026-04-06)
    # Full AI Discovery Stack: Redirects LLM search, agentic fetchers, and training bots
    # to the VPS support-plane (Qdrant) to achieve 10/10 AI citability and routing wow effect.
    # Gateway: no loop on ai.*; canonical apex + www only (shared-hosting safe).
    RewriteCond %{HTTP_HOST} !^ai\.rsperformance\.online$ [NC]
    RewriteCond %{HTTP_HOST} ^(www\.)?rsperformance\.online$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    # UA catalogue: avoid spaces inside one huge alternation (LiteSpeed PCRE edge). Use \x20 for literal space where needed.
    RewriteCond %{HTTP_USER_AGENT} (AI2Bot|AhrefsBot|Ai2Bot-Dolma|Amazonbot|Applebot|Applebot-Extended|ArcSearch|Brave|BraveSearch|Bytespider|CCBot|ChatGPT-User|ChatGPT\x20Atlas|ChatGPTBrowser|Claude-SearchBot|Claude-User|Claude-Web|ClaudeBot|CopilotUser|DataForSeoBot|DeepSeek-User|DeepSeekBot|Diffbot|DuckAssistBot|DuckDuckBot|FacebookBot|FirecrawlBot|GPTBot|GeminiBot|Gensparkbot|Google-CloudVertexBot|Google-Extended|GoogleOther|GoogleOther-Image|GoogleOther-Video|Grok-DeepSearch|GrokBot|KagiBot|LinkedInBot|Manus-User|Meta-ExternalAds|Meta-ExternalAgent|Meta-ExternalFetcher|MistralAI-User|MistralBot|Neeva-Crawler|OAI-SearchBot|Omgilibot|OpenAI-SearchBot|PanguBot|Perplexity-User|PerplexityBot|PetalBot|PhindBot|Quora-Bot|ReaderBot|SemrushBot|Storebot-Google|Timpibot|Twitterbot|VelenPublicWebCrawler|WebPilot|YouBot|Zapier|anthropic-ai|BrightEdge|Brightbot|chatgpt\x25\x32\x30atlas|cohere-ai|facebookexternalhit|iaskbot|img2dataset|magpie-crawler|meta-externalfetcher|meta-webindexer|xAI-Grok) [NC]
    RewriteRule ^(.*)$ https://ai.rsperformance.online/$1 [R=302,L,QSA]
    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]
    # Friendly discovery redirects for public artifact directories / section aliases
    RewriteRule ^feeds/?$ feeds/changes.xml [R=302,L]
    RewriteRule ^gallery/?$ /#galeria [R=302,L]
    # Force all Filament admin routes through Laravel front controller.
    RewriteRule ^admin(/.*)?$ index.php [L]
    # Force Laravel hub routes to index.php even when markdown mirror directories exist
    RewriteRule ^(uslugi|problemy|raporty-napraw|blog)/?$ index.php [L]
    # Blog sub-routes must always go to Laravel (blog/ dir exists for storage)
    RewriteRule ^blog/.+ index.php [L]
    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

</IfModule>
