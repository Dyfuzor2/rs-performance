        "mode": "runOnceForAllItems",
        "jsCode": "const xml = $input.first().json.data;\nconst urlRegex = /<loc>([^<]+)<\\/loc>/g;\nconst urls = [];\nlet match;\nwhile ((match = urlRegex.exec(xml)) !== null) {\n  urls.push(match[1]);\n}\nreturn urls.map(url => ({ json: { url } }));"
