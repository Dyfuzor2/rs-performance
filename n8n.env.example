# Copy to hosting .env (or merge via scripts/merge_n8n_env_hosting.py).
# n8n: Settings → API → Create API key (shown once). Header: X-N8N-API-KEY
# Docs: https://docs.n8n.io/api/authentication/
#
# Główna instancja RS: VPS https://auto.rs3d.pl (ta sama baza co skrypty WOW / flota).
# Osobno SOCmid: https://n8n-s2.socmid.cloud — tylko jeśli Filament ma celowo wskazywać tamtą instancję.

N8N_API_URL=https://auto.rs3d.pl
N8N_EDITOR_BASE_URL=https://auto.rs3d.pl
N8N_API_KEY=
