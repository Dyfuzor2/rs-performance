{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "a2a:certify": "npx --prefix tools/a2a-overture-runtime overture certify https://rsperformance.online --json",
        "a2a:certify:agent": "npx --prefix tools/a2a-overture-runtime overture certify",
        "a2a:test": "php vendor/bin/pest tests/Feature/A2aStructuredArtifactsTest.php tests/Feature/A2aAgentCardTest.php",
