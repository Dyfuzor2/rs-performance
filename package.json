        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.8",
        "@fontsource/orbitron": "^5.2.8",
        "@modelcontextprotocol/server-filesystem": "^2026.1.14",
        "gsap": "^3.14.2",
