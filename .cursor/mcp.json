{
  "mcpServers": {
    "laravel-boost": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\laravel-boost-mcp-runtime\\run-laravel-boost-mcp.ps1"
      ],
      "description": "Laravel Boost MCP via pinned runtime (same pattern as github-mcp). PHP: GRAVITY_PHP or php.path."
    },
    "filesystem-gravity": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "G:\\gravity"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "n8n-mcp": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\n8n-mcp-runtime\\run-n8n-mcp.ps1"
      ],
      "description": "Same pinned runtime as repo .mcp.json; secrets from .cursor/mcp.env (not Process env)."
    },
    "telegram-rs": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\telegram-mcp-runtime\\run-telegram-mcp.ps1"
      ],
      "description": "Telegram Bot API: getMe + sendMessage; .cursor/mcp.env (TELEGRAM_*)."
    },
    "gcloud-wow": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\gcp-gcloud-wow-runtime\\run-gcloud-wow-mcp.ps1"
      ],
      "description": "Read-only gcloud JSON (version, config list). gcloud on PATH."
    },
    "github": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\github-mcp-runtime\\run-github-mcp.ps1"
      ],
      "description": "Official GitHub MCP (read-only). Install: tools/github-mcp-runtime/install-github-mcp.ps1"
    }
  }
}
