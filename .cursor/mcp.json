{
  "mcpServers": {
    "laravel-boost": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\laravel-boost-mcp-runtime\\run-laravel-boost-mcp.ps1"
      ],
      "description": "Laravel Boost MCP via pinned runtime (same pattern as github-mcp). PHP: GRAVITY_PHP or php.path."
    },
    "filesystem-gravity": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "G:\\gravity"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "n8n-mcp": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\n8n-mcp-runtime\\run-n8n-mcp.ps1"
      ],
      "description": "Same pinned runtime as repo .mcp.json; secrets from .cursor/mcp.env (not Process env)."
    },
    "telegram-rs": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\telegram-mcp-runtime\\run-telegram-mcp.ps1"
      ],
      "description": "Telegram Bot API: getMe + sendMessage; .cursor/mcp.env (TELEGRAM_*)."
    },
    "gcloud-wow": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\gcp-gcloud-wow-runtime\\run-gcloud-wow-mcp.ps1"
      ],
      "description": "Read-only gcloud JSON (version, config list). gcloud on PATH."
    },
    "github": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\github-mcp-runtime\\run-github-mcp.ps1"
      ],
      "description": "Official GitHub MCP (read-only). Install: tools/github-mcp-runtime/install-github-mcp.ps1"
    },
    "playwright-wow": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.70",
        "--headless",
        "--browser",
        "chromium"
      ],
      "description": "Microsoft @playwright/mcp (pinned) — a11y snapshots / browser tools. Complements Cursor IDE browser; use for deterministic automation + AEO smoke."
    },
    "postgres-vps-wow": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\postgres-vps-mcp-runtime\\run-postgres-mcp-wow.ps1"
      ],
      "description": "VPS Postgres via mcp-postgres@1.2.1. POSTGRES_MCP_ENABLED=1 + DATABASE_URL in .cursor/mcp.env. Use SSH tunnel; never commit secrets."
    },
    "qdrant-vps-wow": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "G:\\gravity\\tools\\qdrant-vps-mcp-runtime\\run-qdrant-mcp-wow.ps1"
      ],
      "description": "Official mcp-server-qdrant@0.8.1 -> Qdrant on VPS. QDRANT_MCP_ENABLED=1 + QDRANT_URL in .cursor/mcp.env; requires `uv` + `uv sync` in mcp-servers/qdrant-mcp-official. SSH tunnel to 6333; not a substitute for A2A (see RELAY)."
    }
  }
}
